# Copy to .env.local for local dev, and add the same values in Vercel > Settings > Environment Variables.

# Supabase (server only: never prefix these with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server only)
RESEND_API_KEY=
EMAIL_FROM="Vetta Jimale <hello@vettajimale.tech>"

# Postal address shown in every email footer (required by US law; a PO box counts)
POSTAL_ADDRESS="Manifest, Media, Marketing, & Events (MMME) · 20 Adelphi Street · Brooklyn, NY 11205"

# Public site address, no trailing slash
SITE_URL=https://vettajimale.tech

# Browser Supabase (anon key only — never put the service role in VITE_*)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile for studio signup (/api/staff-signup). Free at dash.cloudflare.com → Turnstile.
# Local/dev may omit CAPTCHA; production fails closed if TURNSTILE_SECRET_KEY is missing.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional browser canonical/OG base (no trailing slash). Falls back to window.location.origin.
VITE_SITE_URL=https://vettajimale.tech

# Cron secret for /api/cms-publish-due, /api/lead-magnet-deliver, /api/newsletter-send
CRON_SECRET=

# Required for POST /api/newsletter-webhook (Resend signing secret whsec_… or dedicated Bearer).
# Do not reuse CRON_SECRET.
NEWSLETTER_WEBHOOK_SECRET=

# Stripe Checkout (book PDF). Leave blank until you have keys — /api/checkout returns 503 until set.
# Prefer a restricted key (rk_…) with Checkout + webhook permissions over a full secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID from Stripe Dashboard → Product → Pricing (e.g. price_…)
STRIPE_BOOK_PRICE_ID=
# Paid PDF object in the media-private bucket (preferred). Example: books/i-call-bs.pdf
BOOK_PRIVATE_PATH=
# Legacy public/CDN URL used only when BOOK_PRIVATE_PATH is empty
BOOK_DOWNLOAD_URL=
