# Copy to .env.local for local dev, and add the same values in Vercel > Settings > Environment Variables.

# Supabase (server only: never prefix these with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe keys for /admin and published CMS reads. NEVER put the service role here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Resend (server only)
RESEND_API_KEY=
EMAIL_FROM="V. Jimale Ridgeway <hello@vettajimale.tech>"

# Public site address, no trailing slash
SITE_URL=https://vettajimale.tech
